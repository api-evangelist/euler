              {
                "name": "assets",
                "value": "",
                "type": "query",
                "description": "Deprecated alias for `addresses`."
              }
            ]
          },
          "docs": "Batch prices for tokens"
        },
        {
          "info": {
            "name": "Historical prices",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/v3/prices/history",
            "params": [
              {
                "name": "chainId",
                "value": "",
                "type": "query"
              },
              {
                "name": "addresses",
                "value": "",
                "type": "query",
                "description": "Comma-separated token addresses."
              },
              {
                "name": "assets",
                "value": "",
