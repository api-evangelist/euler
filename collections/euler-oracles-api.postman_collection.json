    {
      "id": "3203c48a-abd3-405f-91f9-8129045c3d21",
      "name": "Oracles",
      "description": {
        "content": "Oracle routing, adapter, and price-source inspection endpoints. These expose pricing/oracle internals that were previously harder to inspect externally.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "2ada4968-fe76-42a0-9a55-055b0a53b35b",
          "name": "Vault-scoped oracle prices",
          "request": {
            "name": "Vault-scoped oracle prices",
            "description": {
              "content": "Supports exact mode (`chainId + vault + asset`) and list mode (`chainId` + pagination).\n- Exact mode requires the full key.\n- Exact mode returns `200` with `price: null` when the tuple is known but currently unpriced.\n- Non-null `price` values are exact contract-derived prices encoded as 18-decimal bigint strings in `unitOfAccount` terms.\n- Exact mode returns `404` only when the `(chainId, vault, asset)` tuple is unknown.\n- Partial exact key requests return `400`.\n- List mode returns flat rows sorted by `vault ASC, asset ASC`.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v3",
                "oracles",
                "prices"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "chainId",
                  "value": "<integer>",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "key": "vault",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "asset",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "0"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "20",
                  "description": "Requested page size. Values above the endpoint cap are clamped; the default shared cap is 100."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
