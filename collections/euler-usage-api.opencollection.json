{
  "opencollection": "1.0.0",
  "info": {
    "name": "Euler Data API (V3) Accounts Usage API",
    "version": "3.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Usage",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Usage statistics for the authenticated API key",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/v3/usage/stats",
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Usage statistics for the authenticated API key"
        }
      ]
    }
  ],
  "bundled": true
}